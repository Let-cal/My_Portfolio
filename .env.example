# Copy to .env.local (never committed). Without these values the site uses src/content/seed.json.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon key. Safe in the browser; RLS limits it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key, for npm run db:seed only. Never expose it through a NEXT_PUBLIC_ variable or Vercel.
SUPABASE_SERVICE_ROLE_KEY=
# The only address allowed into /admin. It must also be listed in private.app_admins.
ADMIN_EMAIL=
NEXT_PUBLIC_SITE_URL=https://letcal.is-a.dev
