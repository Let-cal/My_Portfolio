{
  "name": "letcal-portfolio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/generate-portrait-props.mjs --use-committed && node scripts/generate-fallback-formats.mjs --use-committed && node scripts/generate-site-icons.mjs --check && tsx scripts/generate-skill-sprite.ts --check",
    "generate:assets": "node scripts/generate-portrait-props.mjs && node scripts/generate-fallback-formats.mjs && node scripts/generate-site-icons.mjs && tsx scripts/generate-skill-sprite.ts",
    "dev": "next dev",
    "build": "next build --webpack",
    "check:bundle": "node scripts/measure-initial-js.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "test:budgets": "node --test tests/scripts/*.test.mjs",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:generated": "node scripts/generate-site-icons.mjs --check && tsx scripts/generate-skill-sprite.ts --check",
    "typecheck": "next typegen && tsc --noEmit",
    "verify:quick": "npm run format:check && npm run lint && npm run check:generated && npm run typecheck",
    "verify": "npm run verify:quick && npm test && npm run build && npm run check:bundle && npm run test:budgets",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:admin:integration": "node scripts/ci/run-admin-integration.mjs",
    "db:schema": "tsx scripts/generate-db-schema.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed-supabase.ts",
    "db:seed-sql": "tsx scripts/seed-supabase.ts --sql",
    "db:verify": "tsx --env-file=.env.local scripts/verify-supabase.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-slot": "1.5.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "postprocessing": "^6.39.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "sharp": "0.35.5",
    "simple-icons": "^16.35.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "delaunator": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "husky": "9.1.7",
    "jsdom": "^30.1.3",
    "lighthouse": "13.5.0",
    "meshoptimizer": "1.3.0",
    "postcss": "^8.5.31",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@swc/core": "1.16.0"
  }
}
